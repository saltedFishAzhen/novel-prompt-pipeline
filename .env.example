# OpenAI SDK compatible endpoint; include /v1 if your provider requires it.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# Remote self-hosted ComfyUI. Optional API key is for your reverse proxy.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_API_KEY=

# Optional: define multiple named servers and distribute new tasks round-robin.
# COMFYUI_URLS={"gpu_a":"http://127.0.0.1:8188","gpu_b":"http://127.0.0.1:8189"}
# Alternatively: COMFYUI_URLS=http://127.0.0.1:8188,http://127.0.0.1:8189
# COMFYUI_GPU_A_API_KEY=
# COMFYUI_GPU_B_API_KEY=
# COMFYUI_BALANCE=round_robin
# COMFYUI_IMAGE_SERVERS=gpu_a,gpu_b
# COMFYUI_REF2VA_SERVERS=gpu_b
# COMFYUI_I2VA_SERVERS=gpu_a,gpu_b
# COMFYUI_DEFAULT_SERVER=gpu_a
