# Remote self-hosted ComfyUI. Optional API key is for your reverse proxy.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_API_KEY=

# Official OpenAI Images client. Export in your process; .env is NOT auto-loaded.
# Keep real credentials out of Git, prompts and screenshots.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
